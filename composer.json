{
    "name": "laikait/laika-core",
    "description": "Laika PHP Framework Core",
    "type": "package",
    "license": "MIT",
    "autoload": {
        "files": [
            "helpers/loader.php"
        ],
        "psr-4": {
            "Laika\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "files": [
            "helpers/loader.php"
        ],
        "psr-4": {
            "Laika\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "laikait/laika-auth": "^2.0",
        "laikait/laika-cli": "^3.0",
        "laikait/laika-model": "^4.0",
        "laikait/laika-queue": "^1.0",
        "laikait/laika-relay": "^1.2",
        "laikait/laika-route": "^2.0",
        "laikait/laika-session": "^5.0",
        "laikait/laika-shield": "^2.0",
        "twig/twig": "^3.28",
        "firebase/php-jwt": "^7.1",
        "aws/aws-sdk-php": "^3.275",
        "filp/whoops": "^2.18",
        "laikait/laika-mailman": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpcompatibility/php-compatibility": "dev-develop"
    },
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit --configuration phpunit.xml.dist --colors=always --testdox"
        ],
        "lint": "php-cs-fixer fix --dry-run --diff",
        "compat": "phpcs --standard=phpcs.xml --report=full"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "extra": {
        "laika": {
            "resources": {
                "functions": {
                    "path": "helpers/functions"
                },
                "hooks": {
                    "path": "helpers/hooks"
                },
                "models": {
                    "path": "src/Model",
                    "namespace": "Laika\\Core\\Model"
                },
                "schemas": {
                    "path": "src/Schema",
                    "namespace": "Laika\\Core\\Schema",
                    "contract": "Laika\\Model\\Contract\\SchemaAbstract"
                }
            }
        }
    }
}
