<?xml version="1.0"?>
<ruleset name="Laika Core PHP Compatibility">
    <description>Ensures compatibility with PHP 8.1 through 8.5.</description>

    <!-- Directories to scan -->
    <file>src</file>
    <file>helpers</file>
    <file>tests</file>

    <!-- PHPCompatibility standard -->
    <rule ref="PHPCompatibility">
        <!--
            Reports the PHP 7.0 left-to-right evaluation change for indirect access.
            Every package here requires PHP >= 8.1, so the old behaviour is unreachable.
        -->
        <exclude name="PHPCompatibility.Variables.NewUniformVariableSyntax"/>

        <!--
            "resource" is only a *soft* reserved word (PHP 7.0) and was never
            enforced. Renaming Laika\Core\App\Resource would break the
            Laika\Service\Resource service, Infra, helpers/loader.php, the
            resource:* CLI commands and the docs. Not worth it for a non-rule.
        -->
        <exclude name="PHPCompatibility.Keywords.ForbiddenNames.resourceFound"/>
    </rule>

    <!-- Define target PHP version -->
    <config name="testVersion" value="8.1-8.5"/>

    <!-- Report every level, and fail the build on warnings too -->
    <arg name="colors"/>
    <arg value="sp"/>
    <config name="ignore_warnings_on_exit" value="0"/>
    <config name="ignore_errors_on_exit" value="0"/>

    <!--
        No vendor/ exclude-pattern here on purpose. PHPCS matches exclude
        patterns against the whole path, so "vendor/" also excludes everything
        when this package is itself checked out inside another project's
        vendor/ directory. The <file> entries above already scope the run.
    -->
</ruleset>
